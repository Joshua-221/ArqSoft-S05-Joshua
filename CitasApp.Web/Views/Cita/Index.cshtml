@model List<CitasApp.Models.Cita>
@using CitasApp.Models
@{
    ViewData["Title"] = "Agenda";
    var pacientes = ViewBag.Pacientes as List<Paciente>;
    var medicos = ViewBag.Medicos as List<Medico>;
    var grupos = Model.OrderBy(c => c.Fecha).ThenBy(c => c.Hora).GroupBy(c => c.Fecha);
}
@functions {
    string ClasePill(string estado) => estado?.ToLower() switch
    {
        "confirmada" => "pill--confirmada",
        "pendiente" => "pill--pendiente",
        "cancelada" => "pill--cancelada",
        _ => "pill--otro"
    };
}

<div class="panel-title">
    <h1>Agenda de citas</h1>
    <span class="count-chip">@Model.Count citas</span>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <strong>No hay citas programadas</strong>
        Cuando se agende una, aparecerá aquí.
    </div>
}
else
{
    @foreach (var grupo in grupos)
    {
        <div class="agenda__group">
            <div class="agenda__date">
                <strong>@grupo.Key.ToString("dd 'de' MMMM, yyyy", new System.Globalization.CultureInfo("es-ES"))</strong>
                <span>@grupo.Key.ToString("dddd", new System.Globalization.CultureInfo("es-ES"))</span>
            </div>
            <div class="agenda__list">
                @foreach (var c in grupo)
                {
                    var paciente = pacientes?.FirstOrDefault(p => p.Id == c.PacienteId);
                    var medico = medicos?.FirstOrDefault(m => m.Id == c.MedicoId);
                    <div class="agenda__item">
                        <div class="agenda__time">@c.Hora.ToString("HH:mm")</div>
                        <div class="agenda__divider"></div>
                        <div class="agenda__content">
                            <div class="agenda__motivo">@c.Motivo</div>
                            <div class="agenda__meta">
                                @(paciente != null ? $"{paciente.Nombre} {paciente.Apellido}" : "Paciente —")
                                con
                                @(medico != null ? $"{medico.Nombre} {medico.Apellido}" : "médico —")
                            </div>
                        </div>
                        <div class="agenda__status">
                            <span class="pill @ClasePill(c.Estado)">@c.Estado</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}