@{
    var controllerActual = ViewContext.RouteData.Values["controller"]?.ToString();
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString();
    var esPacientes = controllerActual == "Paciente";
    var esMedicos = controllerActual == "Medico";
    var esAgenda = controllerActual == "Cita";
    var esPrivacidad = controllerActual == "Home" && accionActual == "Privacy";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · CitasApp.Web</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@@0,500;0,600;1,500;1,600&family=IBM+Plex+Sans:wght@@400;500;600&family=IBM+Plex+Mono:wght@@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="site-header__inner">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand__mark">CA</span>
                CitasApp.Web
            </a>
            <ul class="tab-nav">
                <li><a class="tab-nav__item @(esPacientes ? "is-active" : "")" asp-controller="Paciente" asp-action="Index">Pacientes</a></li>
                <li><a class="tab-nav__item @(esMedicos ? "is-active" : "")" asp-controller="Medico" asp-action="Index">Médicos</a></li>
                <li><a class="tab-nav__item @(esAgenda ? "is-active" : "")" asp-controller="Cita" asp-action="Index">Agenda</a></li>
                <li><a class="tab-nav__item @(esPrivacidad ? "is-active" : "")" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a></li>
            </ul>
        </div>
    </header>

    <main role="main" class="page">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer__inner">
            <span>© 2026 CitasApp.Web — fichero clínico digital</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>