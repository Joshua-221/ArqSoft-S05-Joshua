@model List<CitasApp.Models.Paciente>
@{
    ViewData["Title"] = "Pacientes";
}
@functions {
    string Inicial(string s) => string.IsNullOrEmpty(s) ? "" : s.Substring(0, 1).ToUpper();
}

<div class="panel-title">
    <h1>Pacientes registrados</h1>
    <span class="count-chip">@Model.Count en total</span>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <strong>Aún no hay pacientes</strong>
        Cuando se registre uno, aparecerá aquí.
    </div>
}
else
{
    <div class="roster">
        @foreach (var p in Model)
        {
            <div class="roster__row">
                <div class="roster__avatar">@Inicial(p.Nombre)@Inicial(p.Apellido)</div>
                <div class="roster__main">
                    <div class="roster__name">@p.Nombre @p.Apellido</div>
                    <div class="roster__meta">@p.Email · @p.Telefono</div>
                </div>
                <a class="roster__action" asp-action="Detalle" asp-route-id="@p.Id">Ver expediente →</a>
            </div>
        }
    </div>
}