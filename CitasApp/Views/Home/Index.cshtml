@{
    ViewData["Title"] = "Inicio";
}

<section class="hero">
    <svg class="hero__pulse" viewBox="0 0 360 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M0 18H70L85 4L100 32L115 18H170L185 9L198 27L211 18H360" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="eyebrow">Sistema de citas médicas</span>
    <h1>Cada paciente, cada médico, cada cita, en su lugar.</h1>
    <p>
        CitasApp ordena el día a día del consultorio: el directorio de pacientes,
        la lista de médicos y la agenda de citas, todo en un solo fichero digital.
    </p>
</section>

<div class="entry-grid">
    <a class="entry-card" data-tab="01 · Directorio" asp-controller="Paciente" asp-action="Index">
        <h2>Pacientes</h2>
        <p>Consulta los datos de contacto y el historial de cada paciente registrado.</p>
        <span class="go">Ver pacientes →</span>
    </a>
    <a class="entry-card" data-tab="02 · Plantilla" asp-controller="Medico" asp-action="Index">
        <h2>Médicos</h2>
        <p>Revisa especialidades y número de licencia del equipo médico.</p>
        <span class="go">Ver médicos →</span>
    </a>
    <a class="entry-card" data-tab="03 · Calendario" asp-controller="Cita" asp-action="Index">
        <h2>Agenda</h2>
        <p>Mira las citas programadas por fecha, motivo y estado.</p>
        <span class="go">Ver agenda →</span>
    </a>
</div>