@model CitasApp.Models.Medico
@{
    ViewData["Title"] = $"{Model.Nombre} {Model.Apellido}";
}

<a class="back-link" asp-action="Index">← Volver a la lista</a>

<div class="filecard">
    <span class="filecard__tab">Ficha de médico N.º @Model.Id.ToString("D4")</span>
    <h1>@Model.Nombre @Model.Apellido</h1>
    <hr class="filecard__divider" />
    <div class="filecard__row">
        <span class="filecard__label">Especialidad</span>
        <span class="filecard__value"><span class="tag">@Model.Especialidad</span></span>
    </div>
    <div class="filecard__row">
        <span class="filecard__label">N.º de licencia</span>
        <span class="filecard__value">@Model.NumeroLicencia</span>
    </div>
    <div class="filecard__actions">
        <a class="btn" asp-action="Index">Volver a la lista</a>
    </div>
</div>