@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="filecard">
    <span class="filecard__tab">Incidencia</span>
    <h1>Algo salió mal</h1>
    <hr class="filecard__divider" />
    <p>Ocurrió un error al procesar la solicitud.</p>

    @if (Model.ShowRequestId)
    {
        <div class="filecard__row">
            <span class="filecard__label">Request ID</span>
            <span class="filecard__value">@Model.RequestId</span>
        </div>
    }

    <hr class="filecard__divider" />
    <p style="font-size:0.88rem; color:var(--ink-soft);">
        Activa el entorno <strong>Development</strong> para ver información detallada del error
        durante la depuración local. No debe usarse en aplicaciones desplegadas, ya que puede
        exponer información sensible.
    </p>

    <div class="filecard__actions">
        <a class="btn" asp-controller="Home" asp-action="Index">Volver al inicio</a>
    </div>
</div>